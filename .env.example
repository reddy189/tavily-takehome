# Required
TAVILY_API_KEY="tvly-..."
NEBIUS_API_KEY="..."

# Optional: enable OpenTelemetry tracing (e.g. to a local Phoenix collector).
# Leave unset to run with tracing fully disabled -- the pipeline behaves identically either way.
# ENABLE_TRACING="1"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
